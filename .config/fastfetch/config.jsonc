{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii/creeper.txt",
        "type": "auto",
        "color": {
            "1": "#8A0707" // This colors the entire ASCII block in your blood red
        },
        "padding": {
            "top": 2,
            "left": 2,
            "right": 1
        }
    },
    "display": {
        "separator": " 󰄾 ",
        "color": {
            "keys": "#8A0707" 
        }
    },
    "modules": [
	"break",
	"break",
	"break",
	"break",
        {
            "type": "title",
            "color": {
                "user": "#8A0707",
                "at": "white",
                "host": "#8A0707"
            }
        },
        {
            "type": "separator",
            "string": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
            "color": "#8A0707"
        },
        { "type": "os", "key": "󰣇 OS      ", "keyColor": "#8A0707" },
        { "type": "host", "key": "󰌢 Host    ", "keyColor": "#8A0707" },
        { "type": "kernel", "key": "󰚚 Kern    ", "keyColor": "#8A0707" },
        { "type": "uptime", "key": "󱎫 Up      ", "keyColor": "#8A0707" },
        { "type": "packages", "key": "󰏖 Pkgs    ", "keyColor": "#8A0707" },
        { "type": "display", "key": "󰍹 Res     ", "keyColor": "#8A0707" },
        { "type": "wm", "key": "󱂬 WM      ", "keyColor": "#8A0707" },
        { "type": "terminal", "key": "󰆍 Term    ", "keyColor": "#8A0707" },
        "break",
        { "type": "cpu", "key": "󰻠 CPU     ", "keyColor": "#8A0707" },
        { "type": "gpu", "key": "󰢮 GPU     ", "keyColor": "#8A0707" },
        { "type": "memory", "key": "󰍛 RAM     ", "keyColor": "#8A0707" },
        { "type": "disk", "key": "󰋊 Disk    ", "keyColor": "#8A0707" },
        { "type": "battery", "key": "󰁹 Bat     ", "keyColor": "#8A0707" },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
