{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["custom/mullvad", "network", "custom/bluetooth", "cpu", "memory", "backlight", "pulseaudio", "battery", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "custom/mullvad": {
        "exec": "~/.config/waybar/mullvad.sh",
	"return-type": "json",
        "interval": 2,
        "format": "{}",
        "on-click": "mullvad connect",
        "on-click-right": "mullvad disconnect",
        "tooltip": true
    },
    "network": {
        "interval": 1,
        "min-length": 25,
        "align": 0.5,
        "format-wifi": "󰤨 ↓{bandwidthDownBits:>4} ↑{bandwidthUpBits:>4}",
        "format-ethernet": "󰈀 ETH: {bandwidthTotalBits:>4}",
        "format-disconnected": "󰤭 OFFLINE",
        "on-click": "foot -e nmtui"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU: {usage}%",
        "on-click": "foot -e btop"
    },

    "memory": {
        "interval": 2,
        "format": "MEM: {percentage}%",
        "on-click": "foot -e htop"
    },
    "pulseaudio": {
        "format": "{icon} VOL: {volume}%",
        "format-muted": "󰝟 MUTE",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} Bataria: {capacity}%",
        "format-charging": "󰂄 Batayum: {capacity}%",
        "format-plugged": "󰂄 Batayum: {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 5
    },

    "clock": {
        "format": "{:%H:%M | %d %b }",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
	"custom/bluetooth": {
        "exec": "~/.config/waybar/bt_status.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "foot -e bluetoothctl",
        "on-click-right": "~/.config/waybar/bt_toggle.sh"
    }
}
